# Provider profile for scripts/run_deepinfra_ksi.sh. It holds no real
# credential: scripts/responses_chat_proxy.mjs reads the upstream URL/KEY from
# the parent workspace .env and keeps them on the host.
MODEL_PROVIDER=openai
MODEL_AUTH_MODE=api
OPENAI_API_KEY=local-proxy-placeholder
OPENAI_BASE_URL=http://127.0.0.1:4002/v1
MODEL=Qwen/Qwen3-30B-A3B
REASONING_EFFORT=medium
KSI_OPENAI_API_MODE=chat_completions
